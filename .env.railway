# ==========================================
# AURUM Railway 环境变量模板
# ==========================================
# 使用说明：
# 1. 复制此文件内容到Railway项目的Variables设置
# 2. 填写实际的API密钥和配置值
# 3. 不要将真实密钥提交到Git仓库
# ==========================================

# ---------- OKX交易所配置 ----------
OKX_API_KEY=your_okx_api_key_here
OKX_SECRET_KEY=your_okx_secret_key_here
OKX_PASSPHRASE=your_okx_passphrase_here

# ---------- 飞书通知配置 ----------
FEISHU_WEBHOOK_URL=your_feishu_webhook_url_here
FEISHU_MSG_TYPE=interactive
FEISHU_FORCE_ASCII=0
LOCAL_CHINESE_LOG=1
LOCAL_CHINESE_LOG_PATH=/tmp/feishu_zh.log

# ---------- Gemini AI配置 ----------
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_BASE_URL=https://generativelanguage.googleapis.com
GEMINI_MODEL=gemini-pro

# ---------- Tushare数据配置 ----------
TUSHARE_TOKEN=your_tushare_token_here
TUSHARE_BASE_URL=http://lianghua.nanyangqiankun.top

# ---------- Alpha Vantage配置 ----------
ALPHAVANTAGE_API_KEY=your_alphavantage_api_key_here

# ---------- 交易配置 ----------
INST_ID=XAU-USDT-SWAP
RISK_PER_TRADE=0.01
POSITION_SIZE_PCT=0.30
MAX_TOTAL_POSITION=0.75
STOP_LOSS_PCT=0.015
TAKE_PROFIT_PCT=0.30

# ---------- 杠杆配置 ----------
BASE_LEVERAGE=5
MAX_LEVERAGE=20
MIN_LEVERAGE=1

# ---------- 决策阈值（优化版）----------
MIN_CONFIDENCE=0.50
MIN_SIGNAL=0.20
MIN_CONSENSUS=0.50
MIN_TRADE_INTERVAL_MINUTES=15

# ---------- 宏观分析阈值 ----------
MACRO_BULL_THRESHOLD=50
MACRO_NEUTRAL_THRESHOLD=0

# ---------- 技术指标阈值 ----------
RSI_OVERSOLD=30
RSI_OVERBOUGHT=70
ADX_RANGE_THRESHOLD=15
ADX_TREND_THRESHOLD=25
HURST_RANGE_THRESHOLD=0.45
HURST_TREND_THRESHOLD=0.55

# ---------- 高价值信号过滤 ----------
HIGH_VALUE_FILTER=1
HIGH_VALUE_MIN_MACRO_SCORE=50
HIGH_VALUE_MIN_CONFIDENCE=0.75
HIGH_VALUE_MIN_SIGNAL=0.60
HIGH_VALUE_MIN_CONSENSUS=0.65

# ---------- 金字塔加仓配置 ----------
PYRAMIDING_ENABLED=1
PYRAMID_MIN_PROFIT_R=1.0

# ---------- 时间窗口（UTC）----------
DAYTIME_START=0
DAYTIME_END=12
NIGHTTIME_START=13
NIGHTTIME_END=21

# ---------- 风控限制 ----------
MAX_DAILY_LOSS=0.05

# ---------- K线配置 ----------
ENTRY_TIMEFRAME=3m
ENTRY_LIMIT=300
EXIT_TIMEFRAME=15m
EXIT_LIMIT=200
EXIT_ALT_TIMEFRAME=1H

# ---------- 推送配置 ----------
PUSH_INTERVAL=
PUSH_ON_SIGNAL_ONLY=0
SIGNAL_ONLY=1

# ---------- 汇率配置 ----------
CNY_RATE=7.2

# ---------- Railway专用配置 ----------
# Railway会自动提供以下变量，无需手动设置：
# - PORT（服务端口）
# - RAILWAY_ENVIRONMENT（环境名称）
# - RAILWAY_PROJECT_ID（项目ID）
# - RAILWAY_SERVICE_ID（服务ID）

# ---------- 数据库配置（如需要）----------
# Railway PostgreSQL会自动注入以下变量：
# - DATABASE_URL
# - PGHOST
# - PGPORT
# - PGUSER
# - PGPASSWORD
# - PGDATABASE

# ---------- Redis配置（如需要）----------
# Railway Redis会自动注入以下变量：
# - REDIS_URL
# - REDIS_HOST
# - REDIS_PORT
# - REDIS_PASSWORD

# Trading configuration template
# Copy this file to a local untracked file and replace placeholder values.
# Credentials that were previously committed must be revoked and rotated.

OKX_API_KEY=replace_with_new_okx_api_key
OKX_SECRET_KEY=replace_with_new_okx_secret_key
OKX_PASSPHRASE=replace_with_new_okx_passphrase
FEISHU_WEBHOOK_URL=replace_with_new_feishu_webhook_url

POSITION_SIZE_PCT=0.05
MAX_TOTAL_POSITION=0.20
STOP_LOSS_PCT=0.02
TAKE_PROFIT_PCT=0.04
BASE_LEVERAGE=1
MAX_LEVERAGE=3

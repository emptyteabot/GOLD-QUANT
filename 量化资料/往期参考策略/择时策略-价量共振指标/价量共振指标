    "def pq_index (df,code_list,La,Sa,Lb,Nb):\n",
    "    \n",
    "    #df 数据\n",
    "    #code_list 股票代码\n",
    "    #La：长AMA（AMAL）的移动均线长度  Sa：短AMA（AMAS）的移动均线长度\n",
    "    #Lb：BMA的移动均线长度 Nb：相除的天数差值\n",
    "    #最后返回含有P_Q指标的dataframe\n",
    "    \n",
    "    check=0 #用于确认最后数据量是否正确\n",
    "    data_P_Q = pd.DataFrame()  #用于储存计算结果以输出\n",
    "    \n",
    "    len_code=len(code_list)  #code_list长度\n",
    "    for i_code in range(0,len_code):\n",
    "        \n",
    "        #临时储存，用于计算每个的股票的pq_index\n",
    "        data_tocacu=df[df[\"指数代码\"].isin([code_list[i_code]])]\n",
    "        #重新生成index!\n",
    "        data_tocacu = data_tocacu.reset_index(drop = True)\n",

    "def trade(df,code_list,w,U,D):\n",
    "\n",
    "    '''\n",
    "    df:数据\n",
    "    code_list;交易对象\n",
    "    w;初始财富\n",
    "    U:买入临界值\n",
    "    D:卖出临界值\n",
    " \n",
    "    如果前一天的P_Q指数大于临界值U则购入（hold==1），如果小于临界值D则卖出（hold==0），介于之间则一直持有（hold==1）\n",
    "    假设昨天的收盘价==今天的开盘价，且每天以开盘价买入\n",
    "    '''\n",
    "    \n",
    "    data_trade = pd.DataFrame()  #用于储存计算结果以输出\n",
    "\n",
    "\n",
    "    len_code=len(code_list)\n",
    "    for i_code in range(0,len_code):\n",
    "        final_df=df[df[\"指数代码\"].isin([code_list[i_code]])].reset_index(drop = True)\n",
    "        final_df=final_df.drop(['成交量(亿股)', 'BMA', 'AMAS', 'AMAL'],axis=1)\n",
    "        final_df['hold']=-1  #生成初始持仓状态-1\n",
    "        final_df['w']=w  #生成初始资金\n",
    "\n",
    "        L=len(final_df)\n",
    "        #找到需要买入卖出的点\n",
    "        for i in range (0,L-1):\n",
    "            if final_df.loc[i+1,'P_Q']>U:\n",
    "                final_df.loc[i,'hold']=1\n",
    "\n",
    "            if final_df.loc[i+1,'P_Q']<D:\n",
    "                final_df.loc[i,'hold']=0\n",
    "\n",
    "        #对剩余的hold==-1的中间值进行判断      \n",
    "        for i in range (L-2,-1,-1):   #倒叙判断\n",
    "            if (final_df.loc[i,'hold']== -1) and (final_df.loc[i+1,'hold']== 1) :\n",
    "                final_df.loc[i,'hold']=1\n",
    "            if (final_df.loc[i,'hold']== -1) and (final_df.loc[i+1,'hold']== 0) : \n",
    "                final_df.loc[i,'hold']=0   \n",
    "\n",
    "        #计算财富w的变化\n",
    "        for i in range (L-2,-1,-1):\n",
    "            final_df.loc[i,'w']= final_df.loc[i+1,'w']+ final_df.loc[i,'hold']*   final_df.loc[i,'涨跌幅(%)'] * 0.01 * final_df.loc[i+1,'w']\n",
    "\n",
    "\n",
    "         #储存每个股票的结果\n",
    "        data_trade=data_trade.append( final_df ) \n",
    "    return  data_trade"
   ]
  },

# OKX API配置
OKX_API_KEY=你的API_KEY
OKX_SECRET_KEY=你的SECRET_KEY
OKX_PASSPHRASE=你的PASSPHRASE

# 飞书Webhook
FEISHU_WEBHOOK_URL=你的飞书Webhook地址

# 交易配置（激进模式）
POSITION_SIZE_PCT=0.15  # 单次仓位15%
MAX_TOTAL_POSITION=0.75  # 总仓位75%
STOP_LOSS_PCT=0.10  # 止损10%
TAKE_PROFIT_PCT=0.30  # 止盈30%（盈亏比3:1）
BASE_LEVERAGE=15  # 基础杠杆15倍
MAX_LEVERAGE=20  # 最大杠杆20倍


# ==================== 通知配置 ====================

# 飞书机器人 Webhook（必需 - 至少配置一个）
FEISHU_WEBHOOK_URL=https://open.feishu.cn/open-apis/bot/v2/hook/你的webhook地址

# 微信推送 PushPlus Token（可选）
PUSHPLUS_TOKEN=你的PushPlus_Token

# ==================== AI API 配置（可选）====================

# Grok API（用于新闻分析）
GROK_API_KEY=

# DeepSeek API（用于情绪分析）
DEEPSEEK_API_KEY=
OPENAI_API_KEY=your_openai_compatible_api_key
OPENAI_BASE_URL=https://your-openai-compatible-base-url
OPENAI_MODEL=gpt-5.4
OPENAI_REASONING_EFFORT=medium
ENABLE_FINAL_REASONER=1
FINAL_REASONER_PROVIDER=openai_compat
FINAL_REASONER_TIMEOUT_SEC=45

# ==================== Twitter API（可选）====================

# Twitter API v2 凭证
TWITTER_API_KEY=你的Twitter_API_Key
TWITTER_API_SECRET=你的Twitter_API_Secret
TWITTER_BEARER_TOKEN=你的Twitter_Bearer_Token

# ==================== 交易所 API（可选）====================

# Binance API（如果需要实盘交易）
BINANCE_API_KEY=你的Binance_API_Key
BINANCE_API_SECRET=你的Binance_API_Secret

# OKX API（备用交易所）
OKX_API_KEY=你的OKX_API_Key
OKX_API_SECRET=你的OKX_API_Secret
OKX_PASSPHRASE=你的OKX_Passphrase

# ==================== 配置说明 ====================
#
# 【必需配置】
# 1. FEISHU_WEBHOOK_URL 或 PUSHPLUS_TOKEN（至少配置一个）
#
# 【获取飞书 Webhook】
# 1. 打开飞书APP
# 2. 创建群或使用现有群
# 3. 群设置 → 机器人 → 添加机器人 → 自定义机器人
# 4. 输入名字（如：黄金信号）
# 5. 复制 Webhook 地址
# 6. 粘贴到上面的 FEISHU_WEBHOOK_URL
#
# 【获取 PushPlus Token】
# 1. 访问: https://www.pushplus.plus/
# 2. 微信扫码登录
# 3. 复制 Token
# 4. 粘贴到上面的 PUSHPLUS_TOKEN
#
# 【可选配置】
# - AI API: 用于新闻分析和情绪分析（已提供默认值）
# - Twitter API: 用于监控推特大V（需要申请）
# - 交易所 API: 用于实盘自动交易（目前只推送信号，不自动交易）
#
# ==================== 使用方法 ====================
#
# 1. 复制此文件为 .env
#    Windows: copy env.ultimate.example .env
#    Linux/Mac: cp env.ultimate.example .env
#
# 2. 编辑 .env 文件，填入你的配置
#    Windows: notepad .env
#    Linux/Mac: nano .env
#
# 3. 保存后运行系统
#    python main_ultimate.py
#

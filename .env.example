# AURUM环境变量配置模板
# 复制此文件为.env并填入真实值

# ==================== 数据库配置 ====================
POSTGRES_PASSWORD=aurum_pass_2026
POSTGRES_USER=aurum_user
POSTGRES_DB=aurum

# ==================== Redis配置 ====================
REDIS_PASSWORD=redis_pass_2026

# ==================== RabbitMQ配置 ====================
RABBITMQ_PASSWORD=rabbitmq_pass_2026

# ==================== Grafana配置 ====================
GRAFANA_PASSWORD=admin_2026

# ==================== OKX API配置 ====================
# 请在OKX官网申请API密钥
# https://www.okx.com/account/my-api
OKX_API_KEY=your_api_key_here
OKX_SECRET_KEY=your_secret_key_here
OKX_PASSPHRASE=your_passphrase_here

# ==================== 运行环境 ====================
ENVIRONMENT=production
DEBUG=false

# ==================== CORS配置 ====================
# 允许的前端域名（逗号分隔）
ALLOWED_ORIGINS=https://your-frontend.railway.app,https://your-frontend.vercel.app

# ==================== 日志配置 ====================
LOG_LEVEL=INFO
LOG_FILE=/app/logs/aurum.log

# ==================== 安全配置 ====================
SECRET_KEY=your_secret_key_for_jwt
JWT_EXPIRATION=86400

# ==================== 通知配置 ====================
# 飞书机器人Webhook
FEISHU_WEBHOOK=https://open.feishu.cn/open-apis/bot/v2/hook/your_webhook

# 邮件配置
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASSWORD=your_email_password

# ==================== 交易配置 ====================
# 交易模式: paper(模拟) / live(实盘)
TRADING_MODE=paper

# 最大杠杆
MAX_LEVERAGE=3

# 最大回撤阈值
MAX_DRAWDOWN_THRESHOLD=0.15

# ==================== 监控配置 ====================
PROMETHEUS_PORT=9090
GRAFANA_PORT=3001

# AURUM后端环境变量配置

# 应用配置
APP_NAME=AURUM API
APP_VERSION=1.0.0
DEBUG=True

# 数据库配置
DATABASE_URL=postgresql://postgres:password@localhost:5432/aurum_db
TIMESCALE_URL=postgresql://postgres:password@localhost:5432/aurum_timeseries

# Redis配置
REDIS_URL=redis://localhost:6379/0

# JWT配置（生产环境请修改为随机密钥）
SECRET_KEY=your-secret-key-change-in-production-use-openssl-rand-hex-32
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# API密钥加密（生产环境请修改为随机密钥）
ENCRYPTION_KEY=your-encryption-key-32-bytes-long-change-this

# CORS配置
CORS_ORIGINS=["http://localhost:3000","http://localhost:8000"]

# 限流配置
RATE_LIMIT_PER_MINUTE=100
